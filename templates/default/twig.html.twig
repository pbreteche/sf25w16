{% extends 'base.html.twig' %}
{# Permet de récupérer une structure de "base" et de remplir les emplacements à disposition #}
{# Dès l'instant qu'on étend un autre template, il n'est plus permis d'écrire que dans des blocks #}
{# Seul le template "racine" peut écrire au niveau global #}

{% block body %}
    <h1>Page rendue avec Twig !</h1>
    <p>Test XSS (échappement par défaut) = {{ xss }}</p>
    <p>Test XSS (filtre "raw") = {{ xss | raw }}</p>
    <p>{{ 'now' | date('Y-m-d') }}</p>

    {% if true is not same as false and ('a'..'f') | length < 15 %}
        {# "is" déclenche l'execution d'un test #}
        {# "same as" remplace le "===" #}
        {# not, and, or : opérateurs booléens #}
        {# ".." : définition d'une séquence #}
        <p>C'est différent</p>
    {% elseif 'abcdef'[1:2] == 'bc' %}
        <p>C'est pareil</p>
    {% else %}
        <p>C'est proche</p>
    {% endif %}

    {% for number in (1..20) | filter(n => n is odd) %}
        <p style="color: {{ loop.first ? 'red' : 'blue' }}">number : {{ number }} ({{ loop.index }})</p>
    {% else %}
        <p>La liste est vide.</p>
    {% endfor %}

    <a href="{{ path('app_default_index', {name: 'Symfony'}) }}">Lien</a>

{% endblock %}
