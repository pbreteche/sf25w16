{% extends 'base.html.twig' %}

{% block body %}
    {% set month_name = month | date('F Y') %}
    <h1>{{ 'post.title.index_by_month' | trans({'month_name': month_name}) }}</h1>
    <nav>
        <a href="{{ path('app_post_indexbymonth', {month: month.modify('-1 month') | date('Y-m')}) }}">Préc</a>
        <a href="{{ path('app_post_indexbymonth', {month: month.modify('+1 month') | date('Y-m')}) }}">Suiv</a>
    </nav>
    {% if posts is empty %}
        <p>
            Pas de publication ce mois-ci.
        </p>
    {% else %}
        <ul>
            {% for post in posts %}
                <li><a href="{{ path('app_post_show', {id: post.id}) }}">{{ post.title }}</a></li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
