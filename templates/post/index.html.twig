{% extends 'base.html.twig' %}

{% block body %}
    <h1>Liste des articles</h1>
    <nav>
        <a href="{{ path('app_post_new') }}">Ajouter</a>
    </nav>
    {% if posts is empty %}
        <p>
            Welcome ! Commencez par écrire votre première publication.
            <br><a href="{{ path('app_post_new') }}">Rédiger</a>
        </p>
    {% else %}
        <ul>
        {% for post in posts %}
            <li><a href="{{ path('app_post_show', {id: post.id}) }}">{{ post.title }}</a></li>
        {% endfor %}
        </ul>
    {% endif %}
{% endblock %}