{% extends 'base.html.twig' %}

{% block body %}
    <h1>{{ 'post.title.index' | trans }}</h1>
    <nav>
        <div>
            <a href="{{ path('app_author_post_new') }}">{{ 'post.action.new' | trans }}</a>
            <a href="{{ path('app_post_indexbymonth') }}">{{ 'post.action.browse_by_month' | trans }}</a>
        </div>
        <div>
            <a href="{{ path('app_post_index') }}">{{ 'global.homepage' | trans }}</a>
            {% for category in categories %}
                {#
                    Ajout d'un paramètre "cat" pour la catégorie
                    Ce paramètre n'est pas déclaré dans le chemin de la route
                    Il est alors ajouté à la query string
                #}
                <a href="{{ path('app_post_index', {cat: category.id}) }}">{{ category.name }}</a>
            {% endfor %}
        </div>
    </nav>
    {% if posts is empty %}
        <p>
            {{ 'global.getting_started' | trans }}
            <br><a href="{{ path('app_author_post_new') }}">{{ 'post.action.new' | trans }}</a>
        </p>
    {% else %}
        <form>
            {% for tag in tags %}
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" name="tag-choice[]" id="tag-choice-{{ loop.index }}" value="{{ tag.id }}">
                <label class="form-check-label" for="tag-choice-{{ loop.index }}">{{ tag.name }}</label>
            </div>
            {% endfor %}
            <button class="btn btn-primary">{{ 'global.action.filter' | trans }}</button>
        </form>
        <p>{{ 'demo.plural' | trans({posts: (posts | length)}) }}</p>
        <ul>
        {% for post in posts %}
            <li>
                <a href="{{ path('app_post_show', {id: post.id}) }}">{{ post.title }}</a>
                {% for tag in post.tags %}
                    <span class="badge text-bg-secondary rounded-pill">{{ tag.name }}</span>
                {% endfor %}
            </li>
        {% endfor %}
        </ul>
    {% endif %}
{% endblock %}